# Insurance Claim Processing & Fraud Detection Platform
# Environment Configuration Template

# Server Port (macOS uses 5000 for AirPlay; default set to 5001)
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=super_secret_jwt_insurance_key_2026_sehack
JWT_EXPIRES_IN=7d

# Database Configuration
# Options: 'auto' (tries MySQL on 3306 first, auto-falls back to SQLite), 'mysql', or 'sqlite'
DB_TYPE=auto
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=insurance_claim_db

# File Storage
UPLOAD_DIR=uploads
